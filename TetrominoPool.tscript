# Klasse, die den Pool an verfügbaren Tetrominos enthält
# alle verfügbaren Tetrominos werden zufällig im Array platziert
# und dann nach und nach entfernt bis das Array leer ist
class Tetromino_Pool {
    public:
        var pool = [];

        function get() {
            if this.pool.size() == 0 then {
                print("pool is empty");
                this.fill_pool();
                print(this.pool);
            }
            return this.pool.pop();
        }

        function fill_pool() {
            # verfügbare Tetrominos
            var pool_ = ["o", "s", "z", "i", "l", "j"];

            while pool_.size() > 0 do {
                var random_index = Integer(math.random()*pool_.size());
                this.pool.push(pool_[random_index]);
                pool_.remove(random_index);
            }
        }
}
