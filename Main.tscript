          # Highscore

# alle Files einfügen 
include "TetrominoAufbau";
include "Tetromino";
include "TetrominoPool";
include "Playfield";
include "Graphics";

# wir initalisieren unsere Klassen
var pool = Tetromino_Pool();
var current_tetromino = Tetromino(pool.get());
var renderer = Renderer();
var playfield = Playfield();

# aktuelle Zeit
var previous_time = time();
# Zeitinterval nachdem wieder gezeichnet wird 
# Bestimmt die Fallgeschwindigkeit
var refresh_interval = 100;
# Variable um zu kontrollieren ob ein Block direkt 
# beim spawnen kollidiert und das Spiel endet
var just_spawned = true;

# das "timer" event wird alle 20 Millisekunden aufgerufen
setEventHandler("timer", function(event) {
        if time() - previous_time > refresh_interval then {
             previous_time = time();
             renderer.render(playfield, current_tetromino);

             # Tetromino nach unten bewegen
             current_tetromino.move_down();

             if playfield.check_collision(current_tetromino) == true then {
				 # falls der Tetromino neu ist und direkt kollidiert
				 # das Spiel beenden
                 if just_spawned == true then quitEventMode();
                 current_tetromino.undo();
                 playfield.insert_tetromino(current_tetromino);
                 current_tetromino = Tetromino(pool.get());
                 just_spawned = true;
             }
             else {
                just_spawned = false;
             }
        }
});

# "canvas.keydown" wird aufgerufen wenn ein Knopf auf der Tastatur gedrückt wird
setEventHandler("canvas.keydown", function(event) {
     print(event.key);          # prints the key that was pressed
     if event.key == "ArrowRight" then current_tetromino.move_right();
     if event.key == "ArrowLeft" then current_tetromino.move_left();
     if event.key == "ArrowDown" then current_tetromino.rotate_right();
     if event.key == "ArrowUp" then current_tetromino.rotate_left();

	 # falls der Tetromino eine nicht zulässige Bewegung ausführt
	 # vorherigen Zustand wiederherstellen und die Bewegung rückgangig machen
     if playfield.check_collision(current_tetromino) == true then {
        current_tetromino.undo();
     }

     renderer.render(playfield, current_tetromino);
});

enterEventMode();
