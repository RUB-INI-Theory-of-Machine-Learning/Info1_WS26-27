class Playfield {
    public:
        var blockmap = [];

        constructor() {
            for 0:22 do blockmap.push(Array(12,0));
            # die erste und letzte Reihe sind Rand, dieser wird mit "f" markiert
            # jeweils das erste und letze Element jeder Reihe ist auch Rand
            for var y in 0:22 do {
                for var x in 0:12 do {
                    if y == 0 or y == 21 then {
                            blockmap[y][x] = "f";
                    }
                    if x == 0 or x == 11 then {
                            blockmap[y][x] = "f";
                    }
                }
            }
        }

        function check_collision(tetromino) {
            # wir iterieren durch die blockmap um die Position des dynamischen
            # Tetrominos mit den statischen Elementen des playfields abzugleichen
            for var row in 0:tetromino.blockmap().size() do {
                for var column in 0:tetromino.blockmap()[row].size() do {
                    if tetromino.blockmap()[row][column] != 0 then
                        if this.blockmap[tetromino.row + row][tetromino.column + column] != 0 then return true;
                }
            }
            return false;
        }

        function insert_tetromino(tetromino) {
             # wir iterieren durch die blockmap um den Tetromino
             # in die entsprechenden playfield Stellen zu platzieren
             for var row in 0:tetromino.blockmap().size() do {
                 for var column in 0:tetromino.blockmap()[row].size() do {
                       if tetromino.blockmap()[row][column] != 0 then {
                        this.blockmap[tetromino.row + row][tetromino.column + column] = tetromino.blockmap()[row][column];
            }
        }
    }
}
}

# das playfield bildet das spielfeld ab und
# enthält alle blöcke die sich NICHT bewegen
# wir benutzen ein verschachteltes 2d Array der Größe 22 x 12
# wenn etwas gezeichnet werden soll, ist ein Eintrag nicht null
# und enthält die Farbe des Blocks
